# 从 Obsidian → 设置 → Local REST API 获取；不要提交真实密钥。
OBSIDIAN_API_KEY=replace-with-your-api-key
OBSIDIAN_API_URL=https://127.0.0.1:27124
# 推荐从插件设置导出证书并填写绝对路径。
OBSIDIAN_CA_CERT=
# 仅本机调试可显式设为 false；默认验证证书。
OBSIDIAN_VERIFY_SSL=true
OBSIDIAN_TIMEOUT=20
OBSIDIAN_TEMPLATE_FOLDER=Templates
OBSIDIAN_MAX_NOTE_BYTES=2097152
OBSIDIAN_MAX_ATTACHMENT_BYTES=10485760
OBSIDIAN_MAX_SCAN_FILES=2000
# 开启后只允许读取，MCP 也不注册写入工具。
OBSIDIAN_READ_ONLY=false
